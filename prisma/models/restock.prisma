model RestockRequest {
  id          String        @id @default(cuid())
  status      RestockStatus @default(PENDING)
  stockedById String?

  items     RestockRequestItem[]
  stockedBy User?                @relation(fields: [stockedById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  approvedAt  DateTime?
  cancelledAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([stockedById])
}

model RestockRequestItem {
  id               String @id @default(cuid())
  restockRequestId String
  productId        String
  quantity         Int

  product        Product        @relation(fields: [productId], references: [id])
  restockRequest RestockRequest @relation(fields: [restockRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([restockRequestId])
  @@index([productId])
  @@index([createdAt])
}
