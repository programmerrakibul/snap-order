generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RestockStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_UPDATED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_DELETED

  PRODUCT_RESTOCKED
  PRODUCT_DELETED
  NEW_PRODUCT

  AUTH_LOGIN_ALERT
  AUTH_EMAIL_VERIFIED
  AUTH_PASSWORD_CHANGED
  AUTH_ACCOUNT_CREATED

  SYSTEM_ANNOUNCEMENT
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String?
  photoURL        String?
  phoneNumber     String?
  role            Role             @default(USER)
  isVerified      Boolean          @default(false)
  isActive        Boolean          @default(true)
  orders          Order[]
  products        Product[]
  restockRequests RestockRequest[]
  notifications   Notification[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  lastLoggedIn    DateTime         @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([isActive])
}

model Product {
  id              String               @id @default(cuid())
  name            String               @unique
  description     String
  price           Decimal              @db.Decimal(10, 2)
  stock           Int                  @default(0)
  minThreshold    Int                  @default(10)
  maxThreshold    Int                  @default(100)
  supplier        User?                @relation(fields: [supplierId], references: [id])
  supplierId      String?
  items           OrderItem[]
  restockItems    RestockRequestItem[]
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  lastRestockedAt DateTime?

  @@index([name])
  @@index([createdAt])
  @@index([supplierId])
  @@index([isActive])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  shippingAddress String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  @@index([orderNumber])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
}

model RestockRequest {
  id          String               @id @default(cuid())
  items       RestockRequestItem[]
  status      RestockStatus        @default(PENDING)
  stockedBy   User?                @relation(fields: [stockedById], references: [id])
  stockedById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  approvedAt  DateTime?
  cancelledAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([stockedById])
}

model RestockRequestItem {
  id               String         @id @default(cuid())
  restockRequestId String
  restockRequest   RestockRequest @relation(fields: [restockRequestId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@index([restockRequestId])
  @@index([productId])
  @@index([createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        NotificationType
  read        Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  expiresAt   DateTime?

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}
